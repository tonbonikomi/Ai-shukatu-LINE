# 一柳（Messaging API チャネル）
# ⚠ 既存の就活DBと同じプロバイダーに作ること。別プロバイダーだと userId が照合できない。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 一柳ログイン（LINEログイン チャネル）— 登録LIFFのホスト
# ⚠ LIFF ID を変えると配布済みの入口リンクが全て死ぬ（docs/decisions.md D-004）
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# Supabase の Postgres への直接接続
# community スキーマは PostgREST に公開しないため、直接つなぐ
DATABASE_URL=postgres://user:password@host:5432/postgres

# 運営への通知先（Slack の Incoming Webhook）
# 一柳から運営個人にプッシュで送ると通数を消費するので LINE 外を使う
OPS_SLACK_WEBHOOK_URL=

# プライバシーポリシーの版数。改訂したら上げる（誰がどの版に同意したかを残すため）
PRIVACY_POLICY_VERSION=2026-08-26

# 未登録のまま入室した人に登録を依頼するときの猶予期間（日）
# 発行する使い捨てトークンの有効期限になる（docs/decisions.md D-002）
REGISTRATION_GRACE_DAYS=3
